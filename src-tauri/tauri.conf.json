{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "leyoNET",
  "version": "../package.json",
  "identifier": "app.leyonet.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173/dev.html",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "leyoNET",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "leyoNET – Netzwerke bauen, simulieren und verstehen",
    "longDescription": "Rechnernetze aufbauen, Geräte konfigurieren und den Verkehr auf Paketebene beobachten. Läuft vollständig offline.",
    "copyright": "© 2026 Mark von Allmen & Mikael von Allmen, AGPL-3.0",
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "resources": {
      "../release/THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "THIRD_PARTY_RUST.md": "THIRD_PARTY_RUST.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
